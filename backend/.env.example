# VedicPanditji Backend Environment Configuration
# Copy this to .env when Supabase credentials and server port are assigned.
# DO NOT commit real secrets or production credentials to source control.

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Supabase PostgreSQL & Auth Configuration (To be filled when credentials are provided)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Admin JWT Secret (For backend auth session signing if using custom JWT)
JWT_SECRET=placeholder-jwt-secret-minimum-32-characters

# Admin Notification Webhook (Optional Slack/Email/WhatsApp alerts)
ADMIN_ALERT_WEBHOOK_URL=

