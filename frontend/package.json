{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-pricing.mjs",
    "build": "vite build && node scripts/prerender.js",
    "i18n:check-build": "node scripts/check-i18n-build.mjs",
    "lint": "oxlint",
    "i18n:find": "node scripts/find-hardcoded-text.mjs $(node -p \"require('./scripts/i18n-scope.json').join(' ')\")",
    "i18n:snapshot": "node scripts/snapshot-pages.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "i18n:sheets": "node scripts/make-review-sheets.mjs",
    "test": "node --test \"src/**/*.test.js\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "acorn": "^8.19.0",
    "acorn-jsx": "^5.3.2",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  }
}
