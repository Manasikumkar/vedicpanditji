# VedicPanditji Environment Variables Example
# Set your n8n webhook production URL here:
VITE_N8N_WEBHOOK_URL=https://automate.nirosha.org/webhook/vedicpanditji

# Supabase project (Project Settings -> API). The anon/publishable key is safe to expose;
# row-level security is what protects the data.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>
